 drivers/remoteproc/bt_rproc.c | 279 ++++++++++++++++++++++++++++++++++
 1 file changed, 279 insertions(+)
 create mode 100644 drivers/remoteproc/qcom_m0_btss_pil.c

--- /dev/null
+++ b/drivers/remoteproc/qcom_m0_btss_pil.c
@@ -0,0 +1,267 @@
