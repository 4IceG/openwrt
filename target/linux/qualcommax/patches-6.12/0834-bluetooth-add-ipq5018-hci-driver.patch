+static int btss_ipc_send_msg(struct btss_priv *desc,
+			   uint16_t msg_hdr,
+			   struct sk_buff *skb,
+			   bool dequeue);
+
+static void btss_ipc_process_pending_tx_queue(struct btss_priv *desc, bool purge);
+
+static int btss_ipc_tx_queue(struct btss_priv *desc, struct sk_buff *skb)
+{
+	struct ipc_intent *entry;
+
+	if (atomic_read(&desc->tx_q_cnt) >= IPC_TX_QSIZE) {
+		dev_err(desc->dev, "TX Queue Limit reached\n");
+		return -ENOSPC;
+	}
+
+	entry = kmalloc(sizeof(struct ipc_intent), GFP_ATOMIC);
+	if (!entry)
+		return -ENOMEM;
+
+	entry->skb = skb;
+
+	spin_lock(&desc->lock);
+
+	list_add_tail(&entry->list, &desc->tx_q);
+	atomic_inc(&desc->tx_q_cnt);
+
+	spin_unlock(&desc->lock);
+
+	return 0;
+}
+
+static void btss_ipc_process_pending_tx_queue(struct btss_priv *desc, bool purge)
+{
+	struct ipc_intent *intent;
+	int ret;
+
+	bt_dev_info(desc->hdev, "%s started", __func__);
+
+	while (!list_empty(&desc->tx_q)) {
+		intent = list_first_entry(&desc->tx_q, struct ipc_intent, list);
+
+		if (!purge) {
+			ret = btss_ipc_send_msg(desc, (uint8_t)0x100, intent->skb, false);
+			if (ret)
+				break;
+		}
+
+		list_del(&intent->list);
+		atomic_dec(&desc->tx_q_cnt);
+		kfree_skb(intent->skb);
+		kfree(intent);
+	}
+
+	if (purge)
+		atomic_set(&desc->tx_q_cnt, 0);
+
+	bt_dev_info(desc->hdev, "%s completed", __func__);
+}
+
+static void *btss_ipc_alloc_lmsg(struct btss_priv *desc, uint32_t len,
+		struct ipc_aux_ptr *aux_ptr, uint8_t *is_lbuf_full)
+{
+	uint8_t idx;
+	uint8_t blks;
+	uint8_t blks_consumed;
+	struct device *dev = desc->dev;
+	uint32_t lsz = IPC_LBUF_SZ(desc->tx_ctxt, TotalMemorySize, lring_buf,
+				   lmsg_buf_cnt);
+	void *ret_ptr;
+	aux_ptr->len = 0;
+	aux_ptr->buf = 0;
+
+	bt_dev_info(desc->hdev, "%s started", __func__);
+
+	if (desc->tx_ctxt->lring_buf == 0) {
+		dev_err(dev, "no long message buffer not initialized\n");
+		return ERR_PTR(-ENODEV);
+	}
+
+	blks = GET_NO_OF_BLOCKS(len, lsz);
+
+	if (!desc->lmsg_ctxt.lmsg_free_cnt ||
+			(blks > desc->lmsg_ctxt.lmsg_free_cnt))
+		return ERR_PTR(-EAGAIN);
+
+	idx = desc->lmsg_ctxt.widx;
+
+	if ((desc->lmsg_ctxt.widx + blks) > desc->tx_ctxt->lmsg_buf_cnt) {
+		blks_consumed = desc->tx_ctxt->lmsg_buf_cnt - idx;
+		aux_ptr->len = len - (blks_consumed * lsz);
+		aux_ptr->buf = desc->tx_ctxt->lring_buf;
+	}
+
+	desc->lmsg_ctxt.widx = (desc->lmsg_ctxt.widx + blks) %
+		desc->tx_ctxt->lmsg_buf_cnt;
+
+	desc->lmsg_ctxt.lmsg_free_cnt -= blks;
+
+	if (desc->lmsg_ctxt.lmsg_free_cnt <=
+			((desc->tx_ctxt->lmsg_buf_cnt * 20) / 100))
+		*is_lbuf_full = 1;
+
+	ret_ptr = TO_APPS_ADDR(desc->tx_ctxt->lring_buf) + (idx * lsz);
+
+	/* optional sanity check */
+	if (WARN_ON_ONCE(!ret_ptr))
+		return ERR_PTR(-EFAULT);
+
+	bt_dev_info(desc->hdev, "%s completed", __func__);
+
+	return ret_ptr;
+}
+
+static struct ring_buffer_info *btss_ipc_get_tx_rbuf(struct btss_priv *desc,
+		uint8_t *is_sbuf_full)
+{
+	uint8_t idx;
+	struct ring_buffer_info *rinfo;
+
+	for (rinfo = &(desc->tx_ctxt->sring_buf_info);	rinfo != NULL;
+		rinfo = (struct ring_buffer_info *)(uintptr_t)(rinfo->next)) {
+		idx = (rinfo->widx + 1) % (desc->tx_ctxt->smsg_buf_cnt);
+
+		if (idx != rinfo->tidx) {
+			desc->lmsg_ctxt.smsg_free_cnt--;
+
+			if (desc->lmsg_ctxt.smsg_free_cnt <=
+				((desc->tx_ctxt->smsg_buf_cnt * 20) / 100))
+				*is_sbuf_full = 1;
+
+			return rinfo;
+		}
+	}
+
+	return ERR_PTR(-EAGAIN);
+}
+
+static int btss_ipc_send_msg(struct btss_priv *desc, uint16_t msg_hdr,
+			   struct sk_buff *skb, bool dequeue)
+{
+	struct device *dev = desc->dev;
+	struct ring_buffer_info *rinfo;
+	struct ipc_aux_ptr aux_ptr;
+	struct ring_buffer *rbuf;
+	uint8_t is_lbuf_full = 0;
+	uint8_t is_sbuf_full = 0;
+	u32 offset;
+	void *lmsg_data;
+	int ret = 0;
+
+	bt_dev_info(desc->hdev, "%s started", __func__);
+
+	if (dequeue)
+		btss_ipc_process_pending_tx_queue(desc, false);
+
+	bt_dev_info(desc->hdev, "%s 1", __func__);
+
+	offset = readl(desc->mem_region);
+	bt_dev_info(desc->hdev, "%s: offset after boot: 0x%08x\n", __func__, offset);
+
+	rinfo = btss_ipc_get_tx_rbuf(desc, &is_sbuf_full);
+	bt_dev_info(desc->hdev, "%s 2", __func__);
+	if (IS_ERR(rinfo)) {
+		dev_err(dev, "short msg buf full, queuing msg[%d]\n",
+			atomic_read(&desc->tx_q_cnt));
+		ret = PTR_ERR(rinfo);
+		if (dequeue)
+			ret = btss_ipc_tx_queue(desc, skb);
+		return ret;
+	}
+	bt_dev_info(desc->hdev, "%s 3", __func__);
+
+	rbuf = &((struct ring_buffer *)(TO_APPS_ADDR(rinfo->rbuf)))[rinfo->widx];
+	rbuf->msg_hdr = msg_hdr;
+	rbuf->len = skb->len;
+
+	bt_dev_info(desc->hdev, "%s 4", __func__);
+
+	if (skb->len > IPC_MSG_PLD_SZ) {
+		bt_dev_info(desc->hdev, "%s 5", __func__);
+		rbuf->msg_hdr = rbuf->msg_hdr | IPC_LMSG_MASK;
+
+		aux_ptr.len = 0;
+		aux_ptr.buf = 0;
+
+		lmsg_data = btss_ipc_alloc_lmsg(desc, skb->len,
+				&aux_ptr, &is_lbuf_full);
+
+		if (IS_ERR(lmsg_data)) {
+			dev_err(dev, "long msg buf full, queuing msg[%d]\n",
+				atomic_read(&desc->tx_q_cnt));
+			ret = PTR_ERR(lmsg_data);
+			if (dequeue)
+				ret = btss_ipc_tx_queue(desc, skb);
+			return ret;
+		}
+
+		memcpy_toio(lmsg_data, skb->data,
+				(skb->len - aux_ptr.len));
+
+		if (aux_ptr.buf) {
+			memcpy_toio(TO_APPS_ADDR(aux_ptr.buf),
+				(skb->data + (skb->len - aux_ptr.len)), aux_ptr.len);
+		}
+
+		rbuf->payload.lmsg_data = TO_BT_ADDR(lmsg_data);
+	} else {
+		bt_dev_info(desc->hdev, "%s 6", __func__);
+		memcpy_toio(rbuf->payload.smsg_data, skb->data, skb->len);
+	}
+
+	bt_dev_info(desc->hdev, "%s 7", __func__);
+
+	if (is_sbuf_full || is_lbuf_full)
+		rbuf->msg_hdr = rbuf->msg_hdr | IPC_RACK_MASK;
+
+	bt_dev_info(desc->hdev, "%s 8", __func__);
+	rinfo->widx = (rinfo->widx + 1) % desc->tx_ctxt->smsg_buf_cnt;
+
+	regmap_write(desc->regmap, desc->offset, BIT(desc->bit));
+
+	bt_dev_info(desc->hdev, "%s completed", __func__);
+
+	return ret;
+}
+
+static void btss_ipc_free_lmsg(struct btss_priv *desc, uint32_t lmsg, uint16_t len)
+{
+	uint8_t idx;
+	uint8_t blks;
+	uint32_t lsz = IPC_LBUF_SZ(desc->tx_ctxt, TotalMemorySize, lring_buf,
+				   lmsg_buf_cnt);
+
+	idx = GET_TX_INDEX_FROM_BUF(lmsg, lsz);
+
+	if (idx != desc->lmsg_ctxt.ridx)
+		return;
+
+	blks = GET_NO_OF_BLOCKS(len, lsz);
+
+	desc->lmsg_ctxt.ridx  = (desc->lmsg_ctxt.ridx  + blks) %
+		desc->tx_ctxt->lmsg_buf_cnt;
+
+	desc->lmsg_ctxt.lmsg_free_cnt += blks;
+}
+
+static int btss_ipc_send_ctrl(struct btss_priv *desc, u16 msg_hdr)
+{
+    struct ring_buffer_info *rinfo;
+    struct ring_buffer *rbuf;
+
+    bt_dev_info(desc->hdev, "%s started", __func__);
+
+    rinfo = btss_ipc_get_tx_rbuf(desc, NULL);
+    if (IS_ERR(rinfo))
+        return PTR_ERR(rinfo);
+
+    rbuf = &((struct ring_buffer *)TO_APPS_ADDR(rinfo->rbuf))[rinfo->widx];
+    rbuf->msg_hdr = msg_hdr;
+    rbuf->len = 0;
+
+    rinfo->widx = (rinfo->widx + 1) % desc->tx_ctxt->smsg_buf_cnt;
+
+    regmap_write(desc->regmap, desc->offset, BIT(desc->bit));
+
+    bt_dev_info(desc->hdev, "%s completed", __func__);
+
+    return 0;
+}
+
+static void btss_ipc_cust_msg(struct btss_priv *desc, uint8_t msgid)
+{
+	struct device *dev = desc->dev;
+	uint16_t msg_hdr = 0;
+	int ret;
+
+	dev_info(desc->dev, "%s started", __func__);
+
+	msg_hdr |= msgid;
+
+	switch (msgid) {
+	case IPC_CMD_STOP:
+		// spin_unlock(&desc->lock);
+		// ret = qcom_scm_set_bluetooth_eco_mode(BTSS_PAS_ID, 0x4);
+		// spin_lock(&desc->lock);
+		// if (ret) {
+		// 	dev_err(dev, "Failed to set BT ECO\n");
+		// 	return;
+		// }
+
+		dev_info(dev, "BT IPC Stopped, gracefully stopping APSS IPC\n");
+		break;
+	case IPC_CMD_SWITCH_TO_UART:
+		dev_info(dev, "Configured UART, Swithing BT to debug mode\n");
+		break;
+	case IPC_CMD_PREPARE_DUMP:
+		dev_info(dev, "IPQ crashed, inform BT to prepare dump\n");
+		break;
+	case IPC_CMD_COLLECT_DUMP:
+		dev_info(dev, "BT Crashed, gracefully stopping IPC\n");
+		return;
+	case IPC_CMD_START:
+		// spin_unlock(&desc->lock);
+		// ret = qcom_scm_set_bluetooth_eco_mode(BTSS_PAS_ID, 0x0);
+		// spin_lock(&desc->lock);
+		// if (ret) {
+		// 	dev_err(dev, "Failed to reset BT ECO\n");
+		// 	return;
+		// }
+
+		desc->tx_ctxt = (struct context_info *)((void *)
+			desc->rx_ctxt + desc->rx_ctxt->TotalMemorySize);
+		desc->lmsg_ctxt.widx = 0;
+		desc->lmsg_ctxt.ridx = 0;
+		desc->lmsg_ctxt.smsg_free_cnt = desc->tx_ctxt->smsg_buf_cnt;
+		desc->lmsg_ctxt.lmsg_free_cnt = desc->tx_ctxt->lmsg_buf_cnt;
+		atomic_set(&desc->state, 1);
+
+		dev_info(dev, "BT IPC Started, starting APSS IPC\n");
+		return;
+	default:
+		dev_err(dev, "invalid custom message\n");
+		return;
+	}
+
+	if (unlikely(!atomic_read(&desc->state))) {
+		dev_err(dev, "BT IPC not initialized, no message sent\n");
+		return;
+	}
+
+	atomic_set(&desc->state, 0);
+
+	ret = btss_ipc_send_ctrl(desc, msg_hdr);
+	if (ret)
+		dev_err(dev, "err: sending message\n");
+
+	bt_dev_info(desc->hdev, "%s completed", __func__);
+}
+
+static void bt_recv_hci_frame(struct btss_priv *desc, const u8 *data, size_t len)
+{
+	struct sk_buff *skb;
+
+	skb = bt_skb_alloc(len, GFP_KERNEL);
+	if (!skb)
+		return;
+
+	memcpy(skb_put(skb, len), data, len);
+
+	skb->dev = (void *)desc->hdev;
+	bt_cb(skb)->pkt_type = data[0];
+
+	hci_recv_frame(desc->hdev, skb);
+}
+
+static bool btss_ipc_process_peer_msgs(struct btss_priv *desc,
+		struct ring_buffer_info *rinfo, uint8_t *pRxMsgCount)
+{
+	struct ring_buffer *rbuf;
+	uint8_t ridx, lbuf_idx;
+	uint8_t blks_consumed;
+	struct ipc_aux_ptr aux_ptr;
+	enum ipc_pkt_type pktType = IPC_CUST_PKT;
+	bool ack = false;
+	uint8_t *rxbuf = NULL;
+	unsigned char *buf;
+	uint32_t lsz = IPC_LBUF_SZ(desc->rx_ctxt, TotalMemorySize, lring_buf,
+				   lmsg_buf_cnt);
+
+	ridx = rinfo->ridx;
+
+	rbuf = &((struct ring_buffer *)(TO_APPS_ADDR(
+			desc->rx_ctxt->sring_buf_info.rbuf)))[ridx];
+
+	while (ridx != rinfo->widx) {
+		memset(&aux_ptr, 0, sizeof(struct ipc_aux_ptr));
+
+		rbuf = &((struct ring_buffer *)(TO_APPS_ADDR(
+				desc->rx_ctxt->sring_buf_info.rbuf)))[ridx];
+
+		if (WARN_ON(rbuf->len > IPC_TOTAL_MSG_SZ))
+			rbuf->len = IPC_TOTAL_MSG_SZ;
+
+		if (IS_LONG_MSG(rbuf->msg_hdr)) {
+			rxbuf = TO_APPS_ADDR(rbuf->payload.lmsg_data);
+
+			if (IS_RX_MEM_NON_CONTIGIOUS(rbuf->payload.lmsg_data,
+							rbuf->len, lsz)) {
+
+				lbuf_idx = GET_RX_INDEX_FROM_BUF(
+						rbuf->payload.lmsg_data, lsz);
+
+				blks_consumed = desc->rx_ctxt->lmsg_buf_cnt -
+					lbuf_idx;
+				aux_ptr.len = rbuf->len - (blks_consumed * lsz);
+				aux_ptr.buf = desc->rx_ctxt->lring_buf;
+			}
+		} else {
+			rxbuf = rbuf->payload.smsg_data;
+		}
+
+		if (IS_REQ_ACK(rbuf->msg_hdr))
+			ack = true;
+
+		pktType = IPC_GET_PKT_TYPE(rbuf->msg_hdr);
+
+		switch (pktType) {
+		case IPC_HCI_PKT:
+			buf = kzalloc(rbuf->len, GFP_ATOMIC);
+			if (!buf)
+				return -ENOMEM;
+
+			memcpy_fromio(buf, rxbuf, (rbuf->len - aux_ptr.len));
+
+			if (aux_ptr.buf)
+				memcpy_fromio(buf + (rbuf->len - aux_ptr.len),
+					TO_APPS_ADDR(aux_ptr.buf), aux_ptr.len);
+
+			bt_recv_hci_frame(desc, buf, rbuf->len);
+			kfree(buf);
+			break;
+		case IPC_CUST_PKT:
+			btss_ipc_cust_msg(desc, IPC_GET_MSG_ID(rbuf->msg_hdr));
+			break;
+		case IPC_AUDIO_PKT:
+			break;
+		default:
+			break;
+		}
+
+		ridx = (ridx + 1) % rinfo->ring_buf_cnt;
+	}
+	rinfo->ridx = ridx;
+
+	return ack;
+}
+
+static void btss_ipc_process_ack(struct btss_priv *desc)
+{
+	struct ring_buffer_info *rinfo;
+
+	for (rinfo = &desc->tx_ctxt->sring_buf_info; rinfo != NULL;
+		rinfo = (struct ring_buffer_info *)(uintptr_t)(rinfo->next)) {
+		uint8_t tidx = rinfo->tidx;
+		struct ring_buffer *rbuf = (struct ring_buffer *)
+			TO_APPS_ADDR(rinfo->rbuf);
+
+		while (tidx != rinfo->ridx) {
+			if (IS_LONG_MSG(rbuf[tidx].msg_hdr)) {
+				btss_ipc_free_lmsg(desc,
+						 rbuf[tidx].payload.lmsg_data,
+						 rbuf[tidx].len);
+			}
+
+			tidx = (tidx + 1) % desc->tx_ctxt->smsg_buf_cnt;
+			desc->lmsg_ctxt.smsg_free_cnt++;
+		}
+
+		rinfo->tidx = tidx;
+	}
+}
+
+static void btss_ipc_worker(struct work_struct *work)
+{
+	struct btss_priv *desc = container_of(work, struct btss_priv, work);
+	struct ring_buffer_info *rinfo;
+	bool ack = false;
+	u32 offset;
+
+	bt_dev_info(desc->hdev, "%s started", __func__);
+
+	if (desc->rproc->state != RPROC_RUNNING)
+		goto out;
+
+	spin_lock(&desc->lock);
+
+	/* First interrupt after boot: RX context not latched yet */
+	if (unlikely(!atomic_read(&desc->state))) {
+		offset = readl(desc->mem_region);
+		dev_info(desc->dev, "%s: offset after boot: 0x%08x\n", __func__, offset);
+		// desc->rx_ctxt = (struct context_info *)(desc->mem_region + 0xe000);
+		desc->rx_ctxt = (struct context_info *)(desc->mem_region + offset);
+	}
+	else {
+		btss_ipc_process_ack(desc);
+	}
+
+	for (rinfo = &(desc->rx_ctxt->sring_buf_info); rinfo != NULL;
+		rinfo = (struct ring_buffer_info *)(uintptr_t)(rinfo->next)) {
+		if (btss_ipc_process_peer_msgs(desc, rinfo, &desc->rx_ctxt->smsg_buf_cnt))
+			ack = true;
+	}
+
+	if (ack)
+		regmap_write(desc->regmap, desc->offset, BIT(desc->bit));
+
+	spin_unlock(&desc->lock);
+
+out:
+	enable_irq(desc->irq);
+	bt_dev_info(desc->hdev, "%s completed", __func__);
+}
+
+static irqreturn_t btss_ipc_irq_handler(int irq, void *data)
+{
+	struct btss_priv *desc = data;
+
+	bt_dev_info(desc->hdev, "%s started", __func__);
+
+	if (queue_work(desc->wq, &desc->work))
+		disable_irq_nosync(irq);
+
+	bt_dev_info(desc->hdev, "%s completed", __func__);
+
+	return IRQ_HANDLED;
+}
+
+static int btss_ipc_init(struct btss_priv *desc)
+{
+	struct device *dev = desc->dev;
+	int ret;
+
+	dev_info(dev, "%s started\n", __func__);
+
+	spin_lock_init(&desc->lock);
+	INIT_LIST_HEAD(&desc->tx_q);
+
+	desc->wq = create_singlethread_workqueue("bt_ipc");
+	if (!desc->wq) {
+		dev_err(dev, "Failed to initialize workqueue\n");
+		return -EAGAIN;
+	}
+
+	INIT_WORK(&desc->work, btss_ipc_worker);
+
+	ret = devm_request_threaded_irq(dev, desc->irq, NULL, btss_ipc_irq_handler,
+					IRQF_TRIGGER_RISING | IRQF_ONESHOT,
+					"bt_ipc_irq", desc);
+
+	if (ret)
+		dev_err(dev, "error registering irq[%d] ret = %d\n",
+			desc->irq, ret);
+
+	dev_info(dev, "%s completed\n", __func__);
+
+	return ret;
+}
+
+static void btss_ipc_deinit(struct btss_priv *desc)
+{
+	struct device *dev = desc->dev;
+
+	dev_info(dev, "%s started\n", __func__);
+
+	atomic_set(&desc->state, 0);
+	if (desc->wq != NULL) {
+		devm_free_irq(dev, desc->irq, desc);
+		btss_ipc_process_pending_tx_queue(desc, true);
+		flush_work(&desc->work);
+		destroy_workqueue(desc->wq);
+	}
+
+	dev_info(dev, "%s completed\n", __func__);
+}
+
+static int btss_ipc_open(struct hci_dev *hdev)
+{
+	struct btss_priv *desc = hci_get_drvdata(hdev);
+
+	int ret;
+
+	ret = btss_ipc_init(desc);
+	if (ret) {
+		bt_dev_err(hdev, "Failed initializing IPC: %d", ret);
+		return ret;
+	}
+
+	/* Boot M0 firmware */
+	ret = rproc_boot(desc->rproc);
+	if (ret) {
+		bt_dev_err(hdev, "Failed to boot m0 processor: %d", ret);
+		return ret;
+	}
+
+	msleep(POWER_CONTROL_DELAY_MS);
+
+	bt_dev_info(hdev, "%s completed", __func__);
+
+	return ret;
+}
+
+static int btss_ipc_close(struct hci_dev *hdev)
+{
+	bt_dev_info(hdev, "%s completed", __func__);
+	return 0;
+}
+
+static int btss_ipc_flush(struct hci_dev *hdev)
+{
+	bt_dev_info(hdev, "%s completed", __func__);
+	return 0;
+}
+
+static int btss_ipc_send(struct hci_dev *hdev, struct sk_buff *skb)
+{
+	struct btss_priv *desc = hci_get_drvdata(hdev);
+	uint16_t hdr = 0x100;
+	int ret;
+
+	if (unlikely(!atomic_read(&desc->state))) {
+	// if (desc->rproc->state != RPROC_RUNNING) {
+		bt_dev_err(hdev, "BT IPC not initialized, no message sent");
+		return -ENODEV;
+	}
+
+	spin_lock(&desc->lock);
+
+	ret = btss_ipc_send_msg(desc, hdr, skb, true);
+	if (ret == -EAGAIN) {
+		ret = btss_ipc_tx_queue(desc, skb);
+		if (ret)
+			bt_dev_err(hdev, "Failed to send message");
+	}
+
+	spin_unlock(&desc->lock);
+
+	if (!ret)
+		kfree_skb(skb);
+	else if (ret == -EAGAIN)
+		ret = 0;
+
+	bt_dev_info(hdev, "%s completed", __func__);
+
+	return ret;
+}
+
+static int btss_ipc_setup(struct hci_dev *hdev)
+{
+	struct qca_btsoc_version ver;
+	// char fwname[64];
+	u8 rom_ver = 0;
+	u32 soc_ver;
+	int ret;
+
+	/* Patch downloading has to be done without IBS mode */
+	// clear_bit(QCA_IBS_ENABLED, &qca->flags);
+
+	/* Enable controller to do both LE scan and BR/EDR inquiry
+	 * simultaneously.
+	 */
+	set_bit(HCI_QUIRK_SIMULTANEOUS_DISCOVERY, &hdev->quirks);
+
+	/* Enable NON_PERSISTENT_SETUP QUIRK to ensure to execute
+	 * setup for every hci up.
+	 */
+	set_bit(HCI_QUIRK_NON_PERSISTENT_SETUP, &hdev->quirks);
+
+	/* Devices do not have persistent storage for BD address. Retrieve
+	 * it from the firmware node property.
+	 */
+	set_bit(HCI_QUIRK_USE_BDADDR_PROPERTY, &hdev->quirks);
+
+	ret = qca_read_soc_version(hdev, &ver, QCA_IPQ5018);
+	if (ret)
+		return -EINVAL;
+
+	soc_ver = get_soc_ver(ver.soc_id, ver.rom_ver);
+	bt_dev_info(hdev, "QCA controller version 0x%08x", soc_ver);
+	rom_ver = ((soc_ver & 0x00000f00) >> 0x04) | (soc_ver & 0x0000000f);
+	// ret = qca_uart_setup(hdev, 0, QCA_IPQ5018, ver, NULL, NULL);
+
+
+	bt_dev_info(hdev, "%s completed", __func__);
+
+	return 0;
+}
+
+static int btss_ipc_set_bdaddr(struct hci_dev *hdev, const bdaddr_t *bdaddr)
+{
+	bt_dev_info(hdev, "%s completed", __func__);
+	return qca_set_bdaddr(hdev, bdaddr);
+}
+
+static int btss_ipc_shutdown(struct hci_dev *hdev)
+{
+	struct btss_priv *desc = hci_get_drvdata(hdev);
+
+	btss_ipc_deinit(desc);
+	rproc_shutdown(desc->rproc);
+
+	msleep(POWER_CONTROL_DELAY_MS);
+
+	return 0;
+}
+
+static int btss_alloc_memory_region(struct btss_priv *desc)
+{
+	struct device *dev = desc->dev;
+	struct resource res;
+	int ret;
+
+	/* lookup reserved-memory region of the remoteproc node */
+	ret = of_reserved_mem_region_to_resource(desc->rproc->dev.parent->of_node, 0, &res);
+	if (ret) {
+		dev_err(dev, "unable to acquire memory-region resource\n");
+		return ret;
+	}
+
+	desc->mem_phys = res.start;
+	desc->mem_reloc = res.start;
+	desc->mem_size = resource_size(&res);
+	desc->mem_region = devm_ioremap_wc(dev, desc->mem_phys, desc->mem_size);
+	if (!desc->mem_region) {
+		dev_err(dev, "unable to map memory region: %pR\n", &res);
+		return -ENOMEM;
+	}
+
+	dev_info(dev, "%s completed\n", __func__);
+
+	return 0;
+}
+
+static int btqcomipc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct btss_priv *desc;
+	phandle rproc_phandle;
+	struct hci_dev *hdev;
+	unsigned int args[2];
+	int ret;
+
+	desc = devm_kzalloc(dev, sizeof(*desc), GFP_KERNEL);
+	if (!desc)
+		return -ENOMEM;
+
+	desc->dev = dev;
+
+	if (of_property_read_u32(dev->of_node, "qcom,rproc", &rproc_phandle))
+		return dev_err_probe(dev, -ENOENT, "Failed to get remoteproc handle\n");
+
+	desc->rproc = rproc_get_by_phandle(rproc_phandle);
+	if (!desc->rproc)
+		return dev_err_probe(dev, -EPROBE_DEFER, "Failed to get remoteproc\n");
+
+	ret = btss_alloc_memory_region(desc);
+	if (ret)
+		return ret;
+
+	desc->regmap = syscon_regmap_lookup_by_phandle_args(dev->of_node, "qcom,ipc", 2, args);
+	if (IS_ERR(desc->regmap))
+		return PTR_ERR(desc->regmap);
+
+	desc->offset = args[0];
+	desc->bit = args[1];
+
+	desc->irq = platform_get_irq(pdev, 0);
+	if (desc->irq < 0)
+		return dev_err_probe(dev, desc->irq, "Failed to acquire IRQ\n");
+
+	hdev = hci_alloc_dev();
+	if (!hdev)
+		return -ENOMEM;
+
+	desc->hdev = hdev;
+	SET_HCIDEV_DEV(hdev, &pdev->dev);
+	hdev->bus = HCI_IPC;
+
+	hdev->open = btss_ipc_open;
+	hdev->close = btss_ipc_close;
+	hdev->setup = btss_ipc_setup;
+	hdev->flush = btss_ipc_flush;
+	hdev->send = btss_ipc_send;
+	hdev->set_bdaddr = btss_ipc_set_bdaddr;
+	hdev->shutdown = btss_ipc_shutdown;
+
+	ret = hci_register_dev(hdev);
+	if (ret < 0) {
+		hci_free_dev(hdev);
+		return dev_err_probe(dev, -EBUSY, "Failed to register hdev\n");
+	}
+
+	hci_set_drvdata(hdev, desc);
+
+	return 0;
+}
+
+static void btqcomipc_remove(struct platform_device *pdev)
+{
+	struct btss_priv *desc = platform_get_drvdata(pdev);
+
+	if (desc->hdev) {
+		hci_unregister_dev(desc->hdev);
+		hci_free_dev(desc->hdev);
+		desc->hdev = NULL;
+	}
+}
+
+static const struct of_device_id btqcomipc_of_match[] = {
+	{ .compatible = "qcom,ipq5018-bt" },
+	{ /* sentinel */},
+};
+MODULE_DEVICE_TABLE(of, btqcomipc_of_match);
+
+static struct platform_driver btqcomipc_driver = {
+	.probe = btqcomipc_probe,
+	.remove = btqcomipc_remove,
+	.driver = {
+		.name = "btqcomipc",
+		.of_match_table = btqcomipc_of_match,
+	},
+};
+
+module_platform_driver(btqcomipc_driver);
+
+MODULE_DESCRIPTION("Qualcomm IPC HCI Driver");
